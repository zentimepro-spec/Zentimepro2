# NUNCA incluir credenciais reais no Git.
# Configure as variáveis abaixo APENAS no painel Vercel (server-side).
# A aplicação funciona com o catálogo local quando os valores não existem.
ZEN_WORKER_URL=https://SEU-WORKER.workers.dev/chat
ZEN_WORKER_SECRET=CONFIGURAR_NO_PAINEL_DA_VERCEL

# Na Cloudflare configure o mesmo ZEN_WORKER_SECRET via wrangler secret put.
# Variável opcional na Cloudflare: ZEN_MODEL.
# O arquivo scripts/capture-portfolio.mjs exige as variáveis abaixo no ambiente de execução.
CLOUDFLARE_ACCOUNT_ID=CONFIGURAR_FORA_DO_GIT
CLOUDFLARE_API_TOKEN=CONFIGURAR_FORA_DO_GIT
